---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { REPOS } from '../site';

// scripts/shots copies each repo's docs/shots/<os>.png here as <id>-<os>.png.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });

const OSES = [
  { id: 'macos', label: 'macOS' },
  { id: 'linux', label: 'Linux' },
  { id: 'windows', label: 'Windows' },
];

const list = [
  {
    id: 'nd',
    name: 'NativeDesktop',
    kind: 'Rust toolkit',
    platforms: 'macOS, Linux, Windows, web',
    href: REPOS.nativedesktop,
    alt: (os: string) => `The NativeDesktop gallery example on ${os}, with a native sidebar and toolbar.`,
  },
  {
    id: 'lynk',
    name: 'Lynk Browser',
    kind: 'Browser',
    platforms: 'macOS, Linux',
    href: REPOS.lynk,
    alt: (os: string) => `Lynk Browser on ${os}, with tabs in a sidebar beside a web page.`,
  },
  {
    id: 'messages',
    name: 'Messages',
    kind: 'iMessage client',
    platforms: 'macOS, Linux, Windows',
    href: REPOS.messages,
    alt: (os: string) => `Messages on ${os}, showing a group thread with demo data.`,
  },
  {
    id: 'music',
    name: 'FormalMusic',
    kind: 'YouTube Music client',
    platforms: 'macOS, Linux, Windows',
    href: REPOS.formalmusic,
    alt: (os: string) => `FormalMusic on ${os}, playing a song with synced lyrics.`,
  },
];

// An app without a shot for the chosen OS shows its first available one, and says so.
const apps = list.map((app) => {
  const have = OSES.filter((os) => files[`../assets/shots/${app.id}-${os.id}.png`]);
  return {
    ...app,
    shots: OSES.map((os) => {
      const shown = have.find((h) => h.id === os.id) ?? have[0];
      return {
        os: os.id,
        src: files[`../assets/shots/${app.id}-${shown.id}.png`].default,
        alt: app.alt(shown.label),
        caption: shown.id === os.id ? `${app.name} on ${os.label}` : `${app.name} isn't on ${os.label}. Showing ${shown.label}.`,
      };
    }),
  };
});
---

<section id="apps" aria-labelledby="apps-title" class="pt-28 lg:pt-36">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-10">
    <div class="reveal max-w-[35rem]">
      <h2 id="apps-title" class="text-[length:var(--text-title)] leading-[1.08] tracking-[-0.02em]">
        Apps that feel native
      </h2>
      <p class="mt-5 max-w-[44ch] text-lead leading-snug text-soft">
        Describe a window once, and each platform draws it with its own controls: AppKit on macOS, and GPUI on Linux, Windows, and the web.
      </p>
    </div>

    <fieldset class="os reveal mt-8 text-small" style="--d: 100ms">
      <legend class="sr-only">Platform for the screenshots</legend>
      <div class="seg">
        {OSES.map((os) => (
          <label>
            <input type="radio" name="apps-os" value={os.id} checked={os.id === 'macos'} class="sr-only" />
            <span>{os.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="ledger mt-8 xl:grid xl:grid-cols-2 xl:items-start xl:gap-x-16">
      <div class="max-w-[35rem] xl:max-w-none">
        <ul class="list flex flex-col gap-10 xl:gap-0 reveal" style="--d: 100ms">
          {apps.map((app, i) => (
            <li>
              {i < 3 && app.shots.map((s) => (
                <figure class="mb-3 xl:hidden" data-os={s.os} hidden={s.os !== 'macos'}>
                  <Picture
                    src={s.src}
                    alt={s.alt}
                    formats={['avif', 'webp']}
                    widths={[390, 560, 780, 1120]}
                    sizes="(min-width: 640px) 560px, calc(100vw - 2.5rem)"
                    loading="lazy"
                    class="shot aspect-[16/10] w-full object-cover object-top"
                  />
                  <figcaption class="mt-2 text-small text-soft">{s.caption}</figcaption>
                </figure>
              ))}
              <a
                href={app.href}
                data-i={i}
                class="row grid min-h-[3.25rem] grid-cols-[1fr_auto] items-center gap-x-4 xl:min-h-11 xl:grid-cols-[42%_1fr_auto]"
              >
                <span class="nm text-body text-ink">{app.name}</span>
                <span class="col-start-1 row-start-2 -mt-2 pb-1 text-small text-soft xl:col-start-2 xl:row-start-1 xl:mt-0 xl:pb-0">
                  {app.kind}
                </span>
                <span class="col-start-2 row-start-1 text-right text-small text-soft xl:col-start-3">
                  {app.platforms}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="reveal mt-12 text-body text-soft" style="--d: 100ms">
          <a class="link text-ink" href={REPOS.nativedesktopDocs}>Read the NativeDesktop docs</a>
        </p>
      </div>

      <div class="reveal pointer-events-none hidden xl:grid" style="--d: 100ms" aria-hidden="true">
        {apps.map((app, i) => app.shots.map((s) => (
          <figure class="frame [grid-area:1/1]" data-frame={`${i}-${s.os}`} data-on={i === 0 && s.os === 'macos' ? '' : undefined}>
            <Picture
              src={s.src}
              alt=""
              formats={['avif', 'webp']}
              widths={[640, 960, 1280]}
              sizes="calc(50vw - 4.5rem)"
              loading="lazy"
              class="shot block h-auto w-full"
            />
            <figcaption class="mt-3 text-small text-soft">{s.caption}</figcaption>
          </figure>
        )))}
      </div>
    </div>
  </div>
</section>

<style>
  .nm {
    transition: color 150ms var(--ease-out);
  }

  .frame {
    opacity: 0;
    transition: opacity 150ms var(--ease-out);
  }

  .frame[data-on] {
    opacity: 1;
  }

  @media (min-width: 80rem) and (hover: hover) and (pointer: fine) {
    .list:has(.row:hover) .row:not(:hover) .nm,
    .list:has(.row:focus-visible) .row:not(:focus-visible) .nm {
      color: var(--soft);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .nm {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('#apps');
  const list = root?.querySelector<HTMLElement>('.list');
  let active = '0';
  let os = 'macos';

  const render = () => {
    root?.querySelectorAll<HTMLElement>('.frame').forEach((f) => {
      f.toggleAttribute('data-on', f.dataset.frame === `${active}-${os}`);
    });
    root?.querySelectorAll<HTMLElement>('figure[data-os]').forEach((f) => {
      f.hidden = f.dataset.os !== os;
    });
  };

  const show = (e: Event) => {
    const row = (e.target as Element).closest<HTMLElement>('a[data-i]');
    if (!row?.dataset.i || row.dataset.i === active) return;
    active = row.dataset.i;
    render();
  };
  list?.addEventListener('pointerover', show);
  list?.addEventListener('focusin', show);

  root?.querySelector('.os')?.addEventListener('change', (e) => {
    os = (e.target as HTMLInputElement).value;
    render();
  });
</script>
